[Unit]
Description=AutoResearch NiceGUI control center
After=network.target researchd.service

[Service]
Type=simple
WorkingDirectory=/opt/autoresearch/web
Environment=AUTORESEARCH_API=http://127.0.0.1:8080/api/v1
Environment=AUTORESEARCH_UI_HOST=127.0.0.1
Environment=AUTORESEARCH_UI_PORT=8081
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project /opt/autoresearch/web python -m autoresearch_ui.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
