[Unit]
Description=AutoResearch local llama.cpp inference
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name autoresearch-llama -p 127.0.0.1:8082:8080 -v /opt/models:/models:ro ghcr.io/ggml-org/llama.cpp@sha256:b0cd5490eefff30b40dcd47f7249a7d7211136908f73fe440a2a86b35a22b23b -m /models/qwen2.5-0.5b-instruct-q4_k_m.gguf --host 0.0.0.0 --port 8080 --threads 4 --ctx-size 8192 --parallel 2
ExecStop=/usr/bin/docker stop autoresearch-llama
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
